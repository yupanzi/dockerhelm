{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    "@semantic-release/changelog",
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i \"s|^version:.*|version: ${nextRelease.version}|\" Chart.yaml && sed -i \"s|^appVersion:.*|appVersion: \\\"${nextRelease.version}\\\"|\" Chart.yaml && helm package .",
      "publishCmd": "helm push \"dockerhelm-${nextRelease.version}.tgz\" \"oci://ghcr.io/$GITHUB_REPOSITORY_OWNER/charts\""
    }],
    ["@semantic-release/git", {
      "assets": ["Chart.yaml", "CHANGELOG.md"],
      "message": "chore(release): ${nextRelease.version} [skip ci]"
    }],
    ["@semantic-release/github", {
      "assets": [{ "path": "dockerhelm-*.tgz" }]
    }]
  ]
}
