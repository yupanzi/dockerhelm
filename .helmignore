# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Repository files that should not be packaged (examples/ is retained for use after helm pull)
.github/
CLAUDE.md
*.tgz
# Release tooling (semantic-release runs npm install + helm package in this directory)
.releaserc.json
CHANGELOG.md
node_modules/
package.json
package-lock.json
